{
  "manifest_version": 3,
  "name": "Keep The Page",
  "version": "0.1.924.1015",
  "version_name": "0.1 (2026-09-24 10:15)",
  "description": "Stops anti-adblock walls from hiding pages, and removes pop-out video ads and third-party widget clutter.",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "sourcepoint",
        "enabled": true,
        "path": "rules.json"
      },
      {
        "id": "portal",
        "enabled": true,
        "path": "portal-rules.json"
      },
      {
        "id": "widgets",
        "enabled": true,
        "path": "widgets-rules.json"
      }
    ]
  },
